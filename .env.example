# Copy what you need to .env.local (Git-ignored). Never put real values in this file.
# Admin connection used only by data:load and db:reader. The dev container and CI set it themselves.
DATABASE_URL=
# Read-only connection for the MCP server, as copilot_reader. Built from the password below when unset.
COPILOT_DATABASE_URL=
# Random password of the copilot_reader role. `npm run setup:env` writes it to .env.local.
COPILOT_READER_PASSWORD=
# Anthropic API key for the live model (milestone 9). Prefer a Codespaces secret over this file.
ANTHROPIC_API_KEY=
